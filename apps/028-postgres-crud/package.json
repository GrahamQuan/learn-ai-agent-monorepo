{
  "name": "028-postgres-crud",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:debug": "node --inspect --import tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "node --inspect-brk ./node_modules/vitest/vitest.mjs --run",
    "test:e2e": "vitest run test/app.e2e-spec.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "@langchain/openai": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.16",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "4.1.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
