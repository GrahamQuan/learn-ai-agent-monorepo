# LangSmith：启用追踪时填写 API Key，并将 LANGCHAIN_TRACING_V2 设为 true。
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=030-mem0
LANGCHAIN_TRACING_V2=false

# 云端 Mem0 示例需要；本地 API 示例无需填写。
MEM0_API_KEY=

# Redis + Mem0 Agent 额外需要。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-3.5-turbo

# 本地 Mem0 API 启用认证时填写。
MEM0_LOCAL_API_KEY=

# 在本目录执行 docker compose up -d redis，宿主机上的 Agent 使用以下地址。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 以下默认值与 src/env.ts 保持一致。
MEMORY_TTL_SECONDS=1800
MEMORY_KEY_PREFIX=agent:short_memory
MEM0_USER_ID=demo_user_001
MEM0_TOP_K=5
